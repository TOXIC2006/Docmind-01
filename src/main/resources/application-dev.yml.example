# Copy this file to application-dev.yml and fill in the real values.
# application-dev.yml is gitignored, so your secrets never get committed.
#
#   cp application-dev.yml.example application-dev.yml
#
# Every ${VAR:default} below can be satisfied either by editing this file
# directly or by exporting the environment variable.

spring:
  datasource:
    url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5434}/${DB_NAME:docmind}
    username: ${DB_USER:root}
    password: ${DB_PASSWORD}

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    open-in-view: false
    properties:
      hibernate:
        format_sql: true

  # Needed for the registration verification email. Without spring.mail.host no JavaMailSender
  # bean is created, and /docmind/auth/register fails with a message saying so.
  # Gmail example: host smtp.gmail.com, port 587, and an *app password* - not your normal one.
  mail:
    host: ${MAIL_HOST}
    port: ${MAIL_PORT:587}
    username: ${MAIL_USERNAME}
    password: ${MAIL_PASSWORD}
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
            required: true
          connectiontimeout: 5000
          timeout: 5000
          writetimeout: 5000

  ai:
    model:
      chat: openai
      embedding: ollama
      # Every other OpenAI sub-model must be switched off, or its auto-configuration
      # still demands an OpenAI API key at startup even though it is never used.
      image: none
      moderation: none
      audio:
        speech: none
        transcription: none

    openai:
      # Chat goes to Groq through its OpenAI-compatible API. Groq has no embeddings endpoint.
      chat:
        base-url: https://api.groq.com/openai
        api-key: ${GROQ_API_KEY}
        options:
          model: openai/gpt-oss-120b
          temperature: 0.7

    ollama:
      base-url: ${OLLAMA_BASE_URL:http://localhost:11434}
      embedding:
        options:
          model: mxbai-embed-large

    vectorstore:
      pgvector:
        index-type: HNSW      # makes the similarity search faster
        distance-type: COSINE_DISTANCE
        dimensions: 1024      # mxbai-embed-large output size
        table-name: docmind_vectors
        schema-name: public
        initialize-schema: true

  servlet:
    multipart:
      max-file-size: 30MB
      max-request-size: 60MB

# app size
app:
  rag:
    chunk-size: 500
    chunk-overlap: 50
    min-chunklengthtoembed: 5
    max-chunks: 10000
    top-k: 7
    similarity-threshold: 0.0
  cors:
    allowed-origins: "http://localhost:5173"
    allowed-methods: "GET,POST,PUT,DELETE,OPTIONS"
    allowed-headers: "*"

  # Where the verification email links to. Must be the React dev server, not the API.
  frontend-url: ${FRONTEND_URL:http://localhost:5173}

  jwt:
    # HS256 needs at least 32 characters. Generate one with:
    #   openssl rand -base64 48
    # Leave it unset and the app generates a random key per run, which signs everybody
    # out on every restart - fine for a quick test, not for real use.
    secret: ${JWT_SECRET:}
    expiration-minutes: ${JWT_EXPIRATION_MINUTES:1440}
