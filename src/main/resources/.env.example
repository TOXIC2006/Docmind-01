# Copy to .env in this same directory, then fill in the real value.
# docker-compose.yml and application-dev.yml both read DB_PASSWORD.
DB_PASSWORD=your-local-postgres-password

# Optional - application-dev.yml also accepts these as env vars
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# Signing key for the login tokens. At least 32 characters. Generate with: openssl rand -base64 48
# JWT_SECRET=
# JWT_EXPIRATION_MINUTES=1440

# SMTP account used to send the registration verification email.
# For Gmail this must be a 16-character app password, not your normal password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-app-password

# Where the verification email links back to (the React app, not the API)
# FRONTEND_URL=http://localhost:5173
